{
  "name": "sb-cde-monitoring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:ao": "node scripts/ao-preview.mjs",
    "dev:api": "tsx src/server/index.ts",
    "dev:web": "vite",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "fast-xml-parser": "^5.0.8",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0",
    "web-ifc": "^0.0.78",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}

